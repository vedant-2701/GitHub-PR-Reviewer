# ── GitHub App ───────────────────────────────────────────────────────────────
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=./github-private-key.pem
GITHUB_WEBHOOK_SECRET=

# ── Groq ─────────────────────────────────────────────────────────────────────
GROQ_API_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
# Production (PostgreSQL):
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ace_review
# Local dev without Docker (SQLite — set this in your local .env):
# DATABASE_URL=sqlite+aiosqlite:///./dev.db

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development          # development | production
LOG_LEVEL=INFO
BYPASS_GUARDRAILS=false          # ONLY set true in test environment — never production
